# .env — systemd EnvironmentFile 로 읽힙니다. 값에 따옴표를 쓰지 마세요.

# 데이터베이스 파일 위치 (백업 대상)
HOME_DB_PATH=/home/pi/home_dashboard/home.db
HOME_HOST=0.0.0.0
HOME_PORT=8000
HOME_TZ=Asia/Seoul

# 알림 채널: console | ntfy | telegram
HOME_NOTIFY_CHANNEL=ntfy

# --- ntfy 를 쓸 때 (핸드폰에 ntfy 앱 설치 후 아래 토픽 구독) ---
# 토픽 이름은 아무나 구독할 수 있으니 반드시 추측 불가능하게 지으세요.
HOME_NTFY_SERVER=https://ntfy.sh
HOME_NTFY_TOPIC=우리집-바꿔주세요-9f2k4d
# 자체 호스팅 ntfy 에서 인증을 쓰는 경우에만
# HOME_NTFY_TOKEN=tk_xxxxx

# --- 텔레그램을 쓸 때 ---
# HOME_TELEGRAM_TOKEN=123456:ABC-DEF...
# HOME_TELEGRAM_CHAT_ID=987654321

# 아침 요약 알림 시각, 일정 시작 몇 분 전에 알릴지
HOME_DIGEST_TIME=08:00
HOME_EVENT_LEAD_MINUTES=30
